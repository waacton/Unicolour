<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Wacton.Unicolour.Example.Heatmaps</AssemblyName>
    <RootNamespace>Wacton.Unicolour.Example.Heatmaps</RootNamespace>
    <LangVersion>default</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>William Acton</Authors>
    <Product>Wacton.Unicolour.Example.Heatmaps</Product>
  </PropertyGroup>

  <!-- 
  Unicolour uses a community license for SixLabors, which is not committed to the repo 
  https://sixlabors.com/posts/licence-enforcement-changes/ · https://sixlabors.com/pricing/ · https://licensing.sixlabors.com/ · 
  -->
  <PropertyGroup>
    <SixLaborsLicenseFile>../sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unicolour.Datasets\Unicolour.Datasets.csproj" />
    <ProjectReference Include="..\Unicolour\Unicolour.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Inconsolata-Regular.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="moon.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="sun.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
